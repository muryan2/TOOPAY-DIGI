const crypto = require('crypto');
const fs = require('fs');

const USERNAME = 'USERNAME_DIGIFLAZZ_ANDA';
const API_KEY = 'API_KEY_ANDA'; // Pastikan sesuai mode (Development / Production)

// Formula signature resmi Digiflazz untuk price-list: md5(username + apiKey + "pricelist")
const sign = crypto
  .createHash('md5')
  .update(USERNAME + API_KEY + 'pricelist')
  .digest('hex');

async function fetchDigiflazzPricelist() {
  try {
    const response = await fetch('https://api.digiflazz.com/v1/price-list', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        cmd: 'prepaid',
        username: USERNAME,
        sign: sign,
      }),
    });

    const result = await response.json();

    // Sesuai dokumentasi, data produk berada di dalam properti .data
    if (result.data) {
      fs.writeFileSync('products.json', JSON.stringify(result, null, 2));
      console.log('Sukses: Daftar harga Digiflazz berhasil disimpan ke products.json');
    } else {
      console.log('Gagal mengambil data:', result);
    }
  } catch (error) {
    console.error('Terjadi kesalahan koneksi:', error);
  }
}

fetchDigiflazzPricelist();
